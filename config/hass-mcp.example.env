# Example environment file for hass-mcp.
#
# Copy to .env (or export these in your service unit / container environment):
#
#     cp config/hass-mcp.example.env .env
#
# Environment variables are the HIGHEST priority layer:
#
#     built-in defaults  ->  config file  ->  environment variables
#
# You can configure everything here, but a structured config file is easier to
# read for anything non-trivial — see config/hass-mcp.example.json. A common
# split is to keep the config file in version control and inject only secrets
# (HA_TOKEN, MCP_AUTH_TOKENS) through the environment.
#
# Every variable below is optional unless noted; the value shown is the default.

# ─── Home Assistant connection ────────────────────────────────────────────────

HA_URL=http://homeassistant.local:8123

# Required. Create one in Home Assistant: Profile -> Long-lived access tokens.
HA_TOKEN=YOUR_LONG_LIVED_ACCESS_TOKEN

# SSL/TLS verification:
#   true            - verify using the system CA store (default)
#   false           - disable verification (self-signed certificates)
#   /path/to/ca.pem - verify against a custom CA bundle
# HA_SSL_VERIFY=true

# ─── Configuration file location ──────────────────────────────────────────────

# Explicit path to the config file. A path that does not exist is a startup
# error rather than a silent fallback to defaults.
# HASS_MCP_CONFIG_FILE=/etc/hass-mcp/hass-mcp.json

# An extra directory to search. Without either variable the file is looked for
# in ./, ./config/, ~/.hass-mcp/ and /etc/hass-mcp/.
# HASS_MCP_CONFIG_DIR=/etc/hass-mcp

# ─── Transport ────────────────────────────────────────────────────────────────

# stdio (default) | sse | streamable-http
# MCP_TRANSPORT=stdio

# Bind address for the HTTP transports only.
# MCP_HOST=127.0.0.1
# MCP_PORT=8000

# DEBUG | INFO | WARNING | ERROR. INFO includes per-request lines naming entity
# IDs and search queries, which are personal data; WARNING drops those and
# keeps errors. See docs/privacy.md.
# LOG_LEVEL=INFO

# ─── MCP bearer authentication (HTTP transports) ──────────────────────────────

# REQUIRED for sse / streamable-http: the server refuses to start without
# either MCP_AUTH_TOKENS or MCP_ALLOW_HA_TOKENS. stdio is unaffected.
#
# Comma-separated client tokens. Generate with: openssl rand -hex 32
# MCP_AUTH_TOKENS=client-one-token,client-two-token

# When true, a bearer token matching none of the above is used as that
# request's Home Assistant token instead of HA_TOKEN, so each client can bring
# its own credential. When false, an unrecognised token is rejected with 401.
# MCP_ALLOW_HA_TOKENS=false

# ─── Exposed tool surface ─────────────────────────────────────────────────────

# 35 of 114 available tools are exposed by default; the rest are the
# pre-consolidation originals the unified tools replaced. Both lists are
# comma-separated. Leave MCP_TOOLS_ENABLED empty for the default set, or use
# "all" for everything. MCP_TOOLS_DISABLED is subtracted from the result, so it
# trims the defaults without restating them. Unknown names are warned about and
# ignored. See config/hass-mcp.example.json for the full list.
# MCP_TOOLS_ENABLED=
# MCP_TOOLS_DISABLED=

# ─── Access policy ────────────────────────────────────────────────────────────

# All three default to permissive: nothing is restricted unless you say so.
#
# Read-only mode refuses every write (service calls and config CRUD); reads
# keep working.
# HASS_MCP_READ_ONLY=false

# Entity allowlist. EMPTY ALLOWS EVERYTHING. Once any pattern is set the list
# becomes authoritative and unmatched entities are denied, for reads and writes.
# Exact IDs or fnmatch globs, comma-separated.
# HASS_MCP_ENTITY_ALLOWLIST=light.living_room,sensor.gpu_*

# Control denylist. Empty denies nothing. A listed entity can be read but never
# controlled, even when it passes the allowlist — a permanent safety floor.
# HASS_MCP_CONTROL_DENYLIST=lock.*,cover.garage_*

# For long lists, keep patterns in a file: one per line, "#" starts a comment.
# Inline and file entries are combined.
# HASS_MCP_ENTITY_ALLOWLIST_FILE=/etc/hass-mcp/allowlist.txt
# HASS_MCP_CONTROL_DENYLIST_FILE=/etc/hass-mcp/denylist.txt

# ─── Caching ──────────────────────────────────────────────────────────────────

# HASS_MCP_CACHE_ENABLED=true
# HASS_MCP_CACHE_BACKEND=memory          # memory | redis | file
# HASS_MCP_CACHE_DEFAULT_TTL=300
# HASS_MCP_CACHE_MAX_SIZE=1000
# HASS_MCP_CACHE_REDIS_URL=redis://localhost:6379/0
# HASS_MCP_CACHE_DIR=.cache

# Per-endpoint TTLs have no environment equivalent — use the "cache.endpoints"
# section of the config file for those.

# ─── VectorDB semantic search ─────────────────────────────────────────────────

# Disabled by default; needs the extra: uv sync --extra vectordb
# HASS_MCP_VECTOR_DB_ENABLED=false
# HASS_MCP_VECTOR_DB_BACKEND=chroma      # chroma | qdrant | weaviate | pinecone
# HASS_MCP_VECTOR_DB_PATH=.vectordb
# HASS_MCP_VECTOR_DB_COLLECTION=entities

# Embeddings
# HASS_MCP_EMBEDDING_MODEL=sentence-transformers
# HASS_MCP_EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# HASS_MCP_EMBEDDING_DIMENSIONS=384
# HASS_MCP_EMBEDDING_DEVICE=cpu

# Indexing
# HASS_MCP_INDEXING_BATCH_SIZE=100
# HASS_MCP_INDEXING_AUTO_INDEX=false
# HASS_MCP_INDEXING_UPDATE_ON_CHANGE=true

# Search
# HASS_MCP_SEARCH_DEFAULT_LIMIT=10
# HASS_MCP_SEARCH_SIMILARITY_THRESHOLD=0.7
# HASS_MCP_SEARCH_HYBRID_SEARCH=false

# Remote backends / hosted embedding providers, as needed:
# HASS_MCP_QDRANT_URL=http://localhost:6333
# HASS_MCP_QDRANT_API_KEY=
# HASS_MCP_WEAVIATE_URL=http://localhost:8080
# HASS_MCP_WEAVIATE_API_KEY=
# HASS_MCP_PINECONE_API_KEY=
# HASS_MCP_PINECONE_ENVIRONMENT=
# HASS_MCP_PINECONE_INDEX_NAME=entities
# HASS_MCP_OPENAI_API_KEY=
# HASS_MCP_OPENAI_MODEL=text-embedding-3-small
# HASS_MCP_COHERE_API_KEY=
# HASS_MCP_COHERE_MODEL=embed-english-v3.0
